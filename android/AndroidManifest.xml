<?xml version="1.0" encoding="utf-8"?>
<!--
  ╔═══════════════════════════════════════════════════════════
  ║  MAYRA — Priya ki Dost
  ║  AndroidManifest.xml (reference / Capacitor / WebView build)
  ╚═══════════════════════════════════════════════════════════
  Place this file in your Android project's app/src/main/
  directory and merge with your existing manifest if using
  Capacitor or a custom WebView wrapper.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.priyakidost.mayra">

    <!-- ════════════ PERMISSIONS ════════════ -->

    <!-- Voice conversation with Mayra (runtime, dangerous) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Gemini API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- "Call Rahul" contact lookup (runtime, dangerous) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Direct call initiation — OPTIONAL.
         Safer default: skip this and use ACTION_DIAL (no permission needed).
         Uncomment only if you explicitly need direct call-without-dialer.
    -->
    <!-- <uses-permission android:name="android.permission.CALL_PHONE" /> -->

    <!-- Background notifications — Android 13+ (runtime, dangerous) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Smoother audio queue (normal, optional) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ════════════ APP VISIBILITY (Android 11+) ════════════
         Required to detect if WhatsApp, YouTube, Instagram, Chrome
         are installed before attempting to open them.
    -->
    <queries>
        <!-- WhatsApp -->
        <package android:name="com.whatsapp" />
        <!-- YouTube -->
        <package android:name="com.google.android.youtube" />
        <!-- Instagram -->
        <package android:name="com.instagram.android" />
        <!-- Chrome -->
        <package android:name="com.android.chrome" />
        <!-- Spotify -->
        <package android:name="com.spotify.music" />
        <!-- Phone/Dialer intent -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- General URL intent -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- ════════════ HARDWARE FEATURES ════════════ -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- ════════════ APPLICATION ════════════ -->
    <application
        android:label="Priya ki Dost"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
